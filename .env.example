# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# KONFIGURASI SUPABASE XII PPLG 1 (DATABASE, AUTH & STORAGE BUCKET)
# Salin ke .env.local di VS Code atau masukkan di Vercel -> Settings -> Environment Variables
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Kredensial Shared Class Admin (Digunakan untuk login bersama 1 kelas)
NEXT_PUBLIC_CLASS_ADMIN_EMAIL="admin@xiipplg1.sch.id"
NEXT_PUBLIC_CLASS_ADMIN_PASSWORD="pplg1-2026"
